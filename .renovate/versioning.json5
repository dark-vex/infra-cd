{
  "packageRules": [
    {
      "description": "awx-ee base image: stay on CentOS Stream 9. Stream 10 needs the x86-64-v3 CPU baseline, the AWX workers' vCPU does not have it, and the first stream10 image died at start in AWX ('Fatal glibc error: CPU does not support x86-64-v3') while CI, whose runners do have it, passed. Only the digest of stream9 may move.",
      "matchDepNames": ["quay.io/centos/centos"],
      "allowedVersions": "/^stream9$/"
    },
    {
      "description": "awx-ee: stay on ansible-core 2.21. 2.22 requires Python >=3.13 on the controller but the EE runs /usr/bin/python3.12 (Stream 9 AppStream has no 3.13), and smoke-test.sh pins 2.21.*. Lifting this means moving the EE to a newer Python and updating smoke-test.sh (#2455). Patch releases of 2.21 still flow.",
      "matchFileNames": ["awx-ee/execution-environment.yml"],
      "matchPackageNames": ["ansible-core"],
      "allowedVersions": "<2.22"
    },
    {
      "description": "Flux notification kinds (Alert, Provider, Receiver): the kubernetes manager's kubernetes-api lookup proposes apiVersions the installed Flux CRDs do not serve (v1 Alert broke the apps Kustomization, #2368). Bump these by hand with a Flux upgrade.",
      "matchManagers": ["kubernetes"],
      "matchDatasources": ["kubernetes-api"],
      "matchPackageNames": ["Alert", "Provider", "Receiver"],
      "enabled": false
    },
    {
      "description": "Flux distribution (FluxInstance spec.distribution.version): one PR per cluster and per minor, so each upgrade is reviewed against that release's notes and can be applied one minor at a time. Approval-gated: nothing is opened until its checkbox is ticked in the Dependency Dashboard, so tick the oldest minor first (nothing stops a skip). A new minor waits 14 days before it is proposed. Scoped to the FluxInstance pins only, the flux CLI pins in workflows/Dockerfiles stay on the default behaviour",
      "matchManagers": ["custom.regex"],
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["fluxcd/flux2"],
      "matchFileNames": ["clusters/*/flux-instance.{yaml,yml}"],
      "dependencyDashboardApproval": true,
      "separateMultipleMinor": true,
      "additionalBranchPrefix": "{{parentDir}}-",
      "commitMessageSuffix": "({{parentDir}})",
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Ignore tag 'stable' of nut exporter",
      "matchPackageNames": ["hon95/prometheus-nut-exporter"],
      "enabled": false
    },
    {
      "description": "Lock postgres to major 17",
      "matchPackageNames": ["postgres", "/postgresql/"],
      "allowedVersions": "^17"
    },
    {
      "description": "Pin zitadel chart to < 10 until v10 hop is planned (login auth change)",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["zitadel"],
      "allowedVersions": "< 10"
    },
    {
      "description": "Pin Digest for FluxCD controller images",
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true,
      "matchPackageNames": [
        "/^ghcr.io/fluxcd//"
      ]
    },
    {
      "description": "k3s: give patches their own update bucket. Without separateMinorPatch, minor and patch share one bucket and only the newest release (a minor, disabled by the next rule) is emitted, so the in-channel patch is never proposed. Cannot be combined with matchUpdateTypes, hence the separate rule",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["k3s-io/k3s"],
      "separateMinorPatch": true
    },
    {
      "description": "k3s: stay within the per-cluster pinned channel (patch/build only)",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["k3s-io/k3s"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "Strip v prefix from github-releases tags for unversioned pins",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["fluxcd/flux2", "prometheus-pve/prometheus-pve-exporter", "grafana/alloy"],
      "extractVersion": "^v(?<version>.+)$"
    },
    {
      "description": "Strip kustomize/ prefix from kustomize github-releases tags",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["kubernetes-sigs/kustomize"],
      "extractVersion": "^kustomize/(?<version>.+)$"
    },
    {
      "description": "Pin velero-plugin-for-aws below the empty x-amz-tagging PutObject bug (breaks Backblaze B2) until a release ships the fix (upstream PR #299 / commit 8dbd6b84, unreleased as of v1.14.2)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["velero/velero-plugin-for-aws"],
      "allowedVersions": "1.14.0"
    },
    {
      "description": "seaweedfs: recompute seaweedfs_download_checksum after a version bump (upstream publishes only md5, so the sha256 is hashed from the release asset). minimumReleaseAge because the linux_amd64.tar.gz asset can appear well after the release is published",
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["seaweedfs/seaweedfs"],
      "minimumReleaseAge": "1 day",
      "postUpgradeTasks": {
        "commands": [".github/scripts/update_seaweedfs_checksum.sh"],
        "fileFilters": ["ansible/seaweedfs/group_vars/seaweedfs.yml"],
        "executionMode": "update"
      }
    }
  ]
}
