# Managed by Ansible (ansible/haproxy) — manual edits will be overwritten.
# Valid on HAProxy 2.6 (Molecule image) and 2.8 (production, Ubuntu 24.04).
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    stats timeout 30s
    user haproxy
    group haproxy
    daemon
    maxconn {{ haproxy_maxconn }}

    # Mozilla "intermediate" TLS profile (carried over from the Ubuntu stock config)
    ssl-default-bind-ciphers {{ haproxy_ssl_ciphers }}
    ssl-default-bind-ciphersuites {{ haproxy_ssl_ciphersuites }}
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets

defaults
    log global
    mode http
    option httplog
    option dontlognull
    timeout connect {{ haproxy_timeout_connect }}
    timeout client {{ haproxy_timeout_client }}
    timeout server {{ haproxy_timeout_server }}
{% for code in haproxy_errorfile_codes %}
    errorfile {{ code }} /etc/haproxy/errors/{{ code }}.http
{% endfor %}

{% set http_svcs = haproxy_http_services | default([]) %}
{% set mail_svcs = haproxy_mail_services | default([]) %}
{% set term_svcs = http_svcs | selectattr('tls_mode', 'equalto', 'terminate') | list %}
# ---------------------------------------------------------------------------
# HTTP :{{ haproxy_http_bind_port }} — host-based routing
# ---------------------------------------------------------------------------
frontend fe_http
    mode http
    option httplog
    bind :{{ haproxy_http_bind_port }}
{% for svc in http_svcs %}
    acl host_{{ svc.name }} hdr(host),field(1,:) -i {{ svc.domains | join(' ') }}
    use_backend be_{{ svc.name }}_http if host_{{ svc.name }}
{% endfor %}

# ---------------------------------------------------------------------------
# HTTPS :{{ haproxy_https_bind_port }} — SNI routing (passthrough unless tls_mode: terminate)
# ---------------------------------------------------------------------------
frontend fe_https
    mode tcp
    option tcplog
    bind :{{ haproxy_https_bind_port }}
    tcp-request inspect-delay {{ haproxy_sni_inspect_delay }}
    tcp-request content accept if { req.ssl_hello_type 1 }
{% for svc in http_svcs %}
    use_backend be_{{ svc.name }}_https if { req.ssl_sni -i {{ svc.domains | join(' ') }} }
{% endfor %}

{% if term_svcs %}
# Terminated-TLS services: loopback hop through an abstract socket.
frontend fe_https_term
    mode http
    option httplog
    bind abns@haproxy-term accept-proxy ssl crt /etc/haproxy/certs/
{% for svc in term_svcs %}
    use_backend be_{{ svc.name }}_http if { ssl_fc_sni -i {{ svc.domains | join(' ') }} }
{% endfor %}

{% endif %}
{% for svc in http_svcs %}
backend be_{{ svc.name }}_http
    mode http
{% for s in svc.servers %}
    server {{ s.name }} {{ s.address }}:{{ s.http_port | default(80) }}{{ ' check' if svc.check | default(true) else '' }}
{% endfor %}

backend be_{{ svc.name }}_https
    mode tcp
{% if svc.tls_mode | default('passthrough') == 'terminate' %}
    server term abns@haproxy-term send-proxy-v2
{% else %}
{% for s in svc.servers %}
    server {{ s.name }} {{ s.address }}:{{ s.https_port | default(443) }}{{ ' check' if svc.check | default(true) else '' }}
{% endfor %}
{% endif %}

{% endfor %}
# ---------------------------------------------------------------------------
# Mail — plain TCP, optional PROXY protocol v2 per service.
# A server without an explicit port connects to the same port the client hit,
# so one listener can serve several mail ports; health checks then probe
# check_port (default: the first listen port).
# ---------------------------------------------------------------------------
{% for svc in mail_svcs %}
listen mail_{{ svc.name }}
    mode tcp
    option tcplog
{% for p in svc.listen_ports %}
    bind :{{ p }}
{% endfor %}
{% for s in svc.servers %}
    server {{ s.name }} {{ s.address }}{{ ':' ~ s.port if s.port is defined else '' }}{% if svc.check | default(true) %} check{% if s.port is not defined %} port {{ svc.check_port | default(svc.listen_ports[0]) }}{% endif %}{% endif %}{{ ' send-proxy-v2' if svc.send_proxy | default(false) else '' }}
{% endfor %}

{% endfor %}
