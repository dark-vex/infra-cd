# Copy to group_vars/all.sops.yaml and encrypt with sops (age recipients from the
# repo .sops.yaml). Never commit the decrypted file.
# Source address of the Zabbix server (or proxy) as the guests see it. The agent
# only answers passive checks that come from this address; behind NAT it is the
# translated address, not the server's own. It is the only access control (no PSK):
# behind NAT that address is the whole remote site's egress, so any host sharing it
# can run passive items. Use a list for several sites; set zabbix_agent_listen_ip
# per host or site to confine the agent to one interface.
zabbix_agent_server: 192.0.2.10
# SSH user with sudo on the guests.
ansible_user: ansible
# Hosts that need another SSH user or port: the value is a Jinja lookup, so the host
# names stay inside the encrypted value (a host_vars file named after a host would put its
# FQDN in the repo path). Keys are the NetBox inventory names. Example:
#   ansible_user: "{{ {'vm-a.example.invalid': 'admin'}.get(inventory_hostname, 'ansible') }}"
#   ansible_port: "{{ {'vm-b.example.invalid': 2222}.get(inventory_hostname, 22) }}"
# Machines whose own hostname differs from their NetBox name, as "netbox-name=hostname"
# strings (a list, not a dict: SOPS leaves dict keys in plaintext). The hostname guard in
# tasks/main.yml compares against the right-hand side for these. Optional.
zabbix_agent_hostname_overrides:
  - vm.example.invalid=vm-short-name
