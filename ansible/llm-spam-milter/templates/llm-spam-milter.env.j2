# Managed by Ansible (llm-spam-milter). root:{{ llm_spam_milter_user }} 0640.
LLM_BASE_URL="{{ llm_spam_milter_base_url }}"
LLM_MODEL="{{ llm_spam_milter_model }}"
LLM_API_KEY="{{ llm_spam_milter_api_key }}"
# libmilter syntax is inet:PORT@HOST (Postfix uses inet:HOST:PORT).
LLM_MILTER_SOCKET="inet:{{ llm_spam_milter_socket_port }}@127.0.0.1"
LLM_MILTER_MODE="{{ llm_spam_milter_mode }}"
LLM_TIMEOUT="{{ llm_spam_milter_timeout }}"
LLM_RATE_PER_MIN="{{ llm_spam_milter_rate_per_min }}"
LLM_BAND_LOW="{{ llm_spam_milter_band_low }}"
LLM_BAND_HIGH="{{ llm_spam_milter_band_high }}"
